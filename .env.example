# Discord application credentials — https://discord.com/developers/applications
DISCORD_APP_ID=your_application_id_here
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_PUBLIC_KEY=your_public_key_here

# The Discord server (guild) where the bot is installed
DISCORD_GUILD_ID=your_server_id_here

# Fallback webhook URL of the second (mirror) channel — Discord or Slack
# incoming webhook. Guilds connected via the dashboard get their own webhook,
# created automatically in the channel the admin picks.
MIRROR_WEBHOOK_URL=your_webhook_url_here

# OAuth2 client secret (Developer Portal -> OAuth2) — enables the dashboard
# "Add to Discord" connect flow.
# DISCORD_CLIENT_SECRET=your_client_secret_here

# Public URLs (production values shown; defaults are the localhost dev ports)
# BACKEND_PUBLIC_URL=https://your-backend.onrender.com
# FRONTEND_URL=https://your-frontend.vercel.app

# Postgres connection string (Neon/Supabase). Optional locally: without it the
# app uses an in-memory store and data is lost on restart.
# DATABASE_URL=postgres://user:pass@host/dbname

# Admin login seed (used only when the users table is empty) + JWT signing key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_min_8_chars
JWT_SECRET=random_64_hex_chars

# Frontend origin(s) allowed to call the API, comma-separated
CORS_ORIGIN=http://localhost:5173

# AI triage (optional). Free key from console.groq.com (starts with gsk_).
# Without a key, tickets are filed as "unclassified" instead of AI-triaged.
# AI_API_KEY=gsk_...
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.1-8b-instant

# Server port (optional, defaults to 3000)
# PORT=3000
