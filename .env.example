# Discord application credentials — https://discord.com/developers/applications
DISCORD_APP_ID=your_application_id_here
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_PUBLIC_KEY=your_public_key_here

# The Discord server (guild) where the bot is installed
DISCORD_GUILD_ID=your_server_id_here

# Webhook URL of the second (mirror) channel — Discord or Slack incoming webhook
MIRROR_WEBHOOK_URL=your_webhook_url_here

# Postgres connection string (Neon/Supabase). Optional locally: without it the
# app uses an in-memory store and data is lost on restart.
# DATABASE_URL=postgres://user:pass@host/dbname

# Server port (optional, defaults to 3000)
# PORT=3000
